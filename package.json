{
  "name": "webceph",
  "version": "1.0.0",
  "private": true,
  "description": "A web app for tracing and analyzing cephalograms and photographs used in the planning of orthodontic treatment.",
  "scripts": {
    "tslint": "tslint src/**/*.ts{,x}",
    "eslint": "eslint *.js src",
    "i18n:template": "ts-node scripts/generateLocaleTemplate.ts -i 'src/components/**/*.tsx' -o src/locale.json",
    "i18n:update": "ts-node scripts/updateLocales.ts -i 'src/locale/*.json' -t src/locale.json",
    "lint": "npm run tslint && npm run eslint",
    "tsc": "tsc --noEmit",
    "test": "node scripts/run-node-tests.js",
    "test:karma": "NODE_ENV=test karma start --single-run",
    "test:watch": "NODE_ENV=test karma start --watch --no-single-run",
    "dev": "NODE_ENV=development HOT=1 node devServer.js",
    "prod": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 webpack --bail",
    "modernizr:build": "modernizr -c modernizr-config.json -d ./src/utils/modernizr.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/forabi/cephalo.git"
  },
  "keywords": [],
  "author": "Muhammad Fawwaz Orabi <mfawwaz93@gmail.com> (http://forabi.github.io)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://gitlab.com/forabi/cephalo/issues"
  },
  "homepage": "https://gitlab.com/forabi/cephalo#README",
