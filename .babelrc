  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": false,
        "targets": {
          "browsers": [
            "last 5 Chrome versions",
            "last 5 Firefox versions",
            "last 2 Edge versions"
          ]
        }
      }
    ],
    "@babel/preset-react"
  ]
}
